# Sao chep file nay thanh .env roi chinh sua neu can:  cp .env.example .env

# --- Docker (chi dung khi bat auth trong docker-compose.yml; mac dinh tat) ---
MONGO_USER=iot
MONGO_PASSWORD=iot123

# --- MQTT (Mosquitto local) ---
# Cong tren may host duoc docker-compose map vao 1883 cua container.
# Dung 1884 de tranh Mosquitto service cai san tren Windows chiem 1883.
MQTT_HOST_PORT=1884
MQTT_HOST=localhost
MQTT_PORT=1884
MQTT_TELEMETRY_TOPIC=iot/sensor/#
MQTT_STATUS_TOPIC=iot/status/#
MQTT_CLIENT_ID=collector-lab2
# Phai trung remote_clientid trong mosquitto.conf; collector dung topic
# $SYS/broker/connection/<id>/state de kiem tra bridge da ket noi chua.
MQTT_BRIDGE_ID=bridge-dungdinh60240505-lab2

# --- MongoDB ---
# MongoDB service cai tren Windows cung thuong chiem 27017. Docker duoc map
# sang 27018 de collector/Streamlit doc dung du lieu trong container.
MONGO_HOST_PORT=27018
# docker-compose.yml mac dinh khong bat auth. Neu bat auth (xem chu thich
# trong docker-compose.yml), doi thanh:
# mongodb://iot:iot123@localhost:27018/?authSource=admin
MONGO_URI=mongodb://localhost:27018/
MONGO_DB=iot_lab2

# --- Retention (so ngay giu du lieu) ---
RAW_RETENTION_DAYS=30
PROCESSED_RETENTION_DAYS=180
LATENCY_RETENTION_DAYS=30
REJECTED_RETENTION_DAYS=7

# --- Hien thi ---
TIMEZONE=Asia/Ho_Chi_Minh
