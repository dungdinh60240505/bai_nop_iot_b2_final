# Sao chep file nay thanh .env roi chinh sua neu can:  cp .env.example .env

# --- Docker (MongoDB root user) ---
MONGO_USER=iot
MONGO_PASSWORD=iot123

# --- MQTT (Mosquitto local) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TELEMETRY_TOPIC=iot/sensor/#
MQTT_STATUS_TOPIC=iot/status/#
MQTT_CLIENT_ID=collector-lab2

# --- MongoDB ---
MONGO_URI=mongodb://iot:iot123@localhost:27017/?authSource=admin
MONGO_DB=iot_lab2

# --- Retention (so ngay giu du lieu) ---
RAW_RETENTION_DAYS=30
PROCESSED_RETENTION_DAYS=180
LATENCY_RETENTION_DAYS=30
REJECTED_RETENTION_DAYS=7

# --- Hien thi ---
TIMEZONE=Asia/Ho_Chi_Minh
